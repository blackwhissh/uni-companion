# Copy to .env for local overrides. Never commit .env.
# Spring Boot does not load .env by itself; export these or pass them to the process.
# Defaults in application-local.yml match the Docker Compose database below.

# Identity service (port 8081)
IDENTITY_DATABASE_URL=jdbc:postgresql://localhost:5433/identity

# Learning service (port 8082)
LEARNING_DATABASE_URL=jdbc:postgresql://localhost:5433/learning

DATABASE_USERNAME=unicompanion
DATABASE_PASSWORD=unicompanion

# HS256 needs at least 32 bytes. The local default in application.yml is used when this is unset.
JWT_SECRET=local-dev-jwt-secret-change-me-32
SEED_ADMIN_EMAIL=admin@uni-companion.local
SEED_ADMIN_PASSWORD=admin-pass-1

# Vertex AI — prefer Spring profiles via .\dev.ps1 -Ai fake|vertex
# (profiles local,fake / local,vertex). Optional env override still works:
# GEMINI_VERTEX_ENABLED=true
GOOGLE_CLOUD_PROJECT=uniconai
GOOGLE_CLOUD_LOCATION=global
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Unset GOOGLE_APPLICATION_CREDENTIALS for local Vertex (use ADC user login).

# Shared study generation
STUDY_MAX_SHARED_VERSIONS=3
STUDY_REPORT_RETIREMENT_THRESHOLD=3
# Bump this whenever prompts, models, or generation rules change incompatibly.
STUDY_GENERATION_REVISION=v3

# PDF uploads for learning-service
STORAGE_LOCAL_PATH=./data/materials

# Web (Vite). Copy the VITE_* lines into apps/web/.env.local
VITE_IDENTITY_API_URL=http://localhost:8081
VITE_LEARNING_API_URL=http://localhost:8082
