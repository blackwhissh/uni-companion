# Normal local (default vite mode): talk to backends directly.
VITE_IDENTITY_API_URL=http://localhost:8081
VITE_LEARNING_API_URL=http://localhost:8082

# Public tunnels: use `npm run dev:qa` (or .\dev.ps1 -TunnelCors).
# That loads `.env.qa` (empty bases + Vite proxy). Do not put tunnel settings here.
# Grok/MCP orchestrator lives in the sibling repo ../uni-companion-qa.
