# Cursor Cloud agent API key (https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=

# Shared secret for Grok MCP / REST (Authorization: Bearer …)
ORCH_MCP_TOKEN=dev-token-change-me

# Orchestrator listen port
ORCH_MCP_PORT=8787

# When true, submit_test_result auto-starts Cursor. Prefer false + approve_fix after review.
AUTO_FIX=false

# App under test — public URL Grok can open (tunnel Vite, or a deployed demo)
QA_BASE_URL=http://localhost:5173
# BASE_URL=http://localhost:5173

# Repo for Cursor Cloud agents
GITHUB_REPO=https://github.com/blackwhissh/uni-companion

# Fix/retest loop limit
MAX_LOOPS=3

# Cursor model id
CURSOR_MODEL=composer-2.5

# Force dry-run even when CURSOR_API_KEY is set (writes fixer prompt to state/)
# DRY_RUN=true
