{
	admin off
	persist_config off
}

{$CADDY_SITE::80} {
	encode gzip
	request_body {
		max_size 25MB
	}

	handle_path /identity/* {
		reverse_proxy identity:8081 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			transport http {
				read_timeout 60s
			}
		}
	}

	handle_path /learning/* {
		reverse_proxy learning:8082 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			transport http {
				read_timeout 180s
				write_timeout 180s
			}
		}
	}

	# SPA fallback: any non-file path serves index.html so deep links like /courses work.
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
