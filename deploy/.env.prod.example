# Copy to /opt/uni-companion/.env.prod on the Google Cloud VM. Never commit this file.

DATABASE_USERNAME=unicompanion
DATABASE_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-to-at-least-32-random-characters
SEED_ADMIN_EMAIL=admin@uni-companion.local
SEED_ADMIN_PASSWORD=change-me-strong-admin-password

# Browser origin for CORS (same-origin via Caddy still uses this as a fallback).
# Use http://YOUR_PUBLIC_IP or https://your.domain
CORS_ALLOWED_ORIGINS=http://localhost

# Prefer a hostname so Caddy can issue HTTPS (example: 34-140-114-189.sslip.io).
# :80 is HTTP-only and will break browsers that force HTTPS.
CADDY_SITE=:80

# fake = no Google credentials required.
# vertex = real Gemini; put a Vertex-capable SA JSON at secrets/gcp.json and set:
AI_PROFILE=fake
GOOGLE_CLOUD_PROJECT=uniconai
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json
